# =============================================================================
# Orbis Backend — Environment Variables
# Copy to .env and fill in your values.
# =============================================================================

# --- Required -----------------------------------------------------------

# PostgreSQL connection string (Azure Database for PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/orbis

# Anthropic API key for AI-generated cluster summaries
ANTHROPIC_API_KEY=sk-ant-...

# Shared API key — if set, all requests must include X-API-Key header.
# Leave empty for open access (local dev).
ORBIS_API_KEY=

# --- Optional (sensible defaults) ----------------------------------------

# Redis connection string for caching (gracefully disabled if unset)
REDIS_URL=rediss://default:password@host:6380

# OpenAI API key (reserved for future embedding features)
# OPENAI_API_KEY=sk-...

# GDELT DOC 2.0 API base URL
# GDELT_DOC_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Cache TTLs (seconds)
# GDELT_CACHE_TTL=900
# SUMMARY_CACHE_TTL=21600

# Clustering resolution in degrees (smaller = more clusters)
# CLUSTER_RESOLUTION_DEG=2.0

# Claude model ID for summaries and the agent
# HAIKU_MODEL_ID=claude-haiku-5-5

# Daily cap on Claude spend in USD, reset at 00:00 UTC
# (the agent and selection summaries stop at 70% of it)
# LLM_DAILY_BUDGET_USD=1.0
