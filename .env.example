# Database (Azure PostgreSQL)
DATABASE_URL=postgresql://user:password@your-server.postgres.database.azure.com:5432/orbis?sslmode=require

# Redis (Upstash)
REDIS_URL=redis://default:your-password@your-endpoint.upstash.io:6379

# AI
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# GDELT (no key needed, but configurable)
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2
