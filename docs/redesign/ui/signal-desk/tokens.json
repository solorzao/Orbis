    },
    "dataLg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "16px",
        "fontWeight": 500,
        "lineHeight": "20px",
        "letterSpacing": "0"
      },
      "$description": "Header readouts (clock, totals).",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-data-lg",
          "fontFeatureSettings": "\"tnum\" 1, \"zero\" 1"
        }
      }
    },
    "data": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": "16px",
        "letterSpacing": "0"
      },
      "$description": "Table values, scores, timestamps.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-data",
          "fontFeatureSettings": "\"tnum\" 1"
        }
      }
    },
    "dataSm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "10.5px",
        "fontWeight": 400,
        "lineHeight": "14px",
        "letterSpacing": "0"
      },
      "$description": "Axis ticks, keyboard hints.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-data-sm",
          "fontFeatureSettings": "\"tnum\" 1"
        }
      }
    }
  },
