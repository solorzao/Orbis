            "css": "--arc-highlight",
            "modes": {
              "light": "#006d92"
            }
          }
        }
      },
      "muted": {
        "$value": "rgba(154, 176, 193, 0.10)",
        "$description": "Links outside the current filter, kept for context.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--arc-muted",
            "modes": {
              "light": "rgba(61, 84, 102, 0.12)"
            }
          }
        }
