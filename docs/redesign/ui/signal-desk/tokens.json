      "on": {
        "$value": "#021018",
        "$description": "Foreground on solid accent.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--accent-on",
            "modes": {
              "light": "#ffffff"
            }
          }
        }
      }
    },
    "signal": {
      "live": {
        "$value": "#2fd38a",
        "$description": "Live data indicator.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--signal-live",
            "modes": {
              "light": "#12825a"
            }
          }
        }
      },
      "warning": {
