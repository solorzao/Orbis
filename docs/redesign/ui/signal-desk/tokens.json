  "dataviz": {
    "$type": "color",
    "sentiment": {
      "$description": "Red to teal through a warm grey. Red keeps the meaning users learned from the current app; teal replaces green so the two ends also differ in lightness (safer for red-green colour blindness). Neutral is grey, not amber, because amber reads as a warning.",
      "n3": {
        "$value": "#ff5a4e",
        "$description": "Strongly negative (<= -0.6).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-n3",
            "modes": {
              "light": "#c62d22"
            }
          }
        }
      },
      "n2": {
        "$value": "#f4836b",
        "$description": "Negative (-0.6 to -0.3).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-n2",
            "modes": {
              "light": "#d9634c"
            }
          }
        }
      },
      "n1": {
        "$value": "#d6a596",
        "$description": "Slightly negative (-0.3 to -0.1).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-n1",
            "modes": {
              "light": "#b98a7d"
            }
          }
        }
      },
      "neutral": {
        "$value": "#8c9aa6",
        "$description": "Neutral (-0.1 to 0.1).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-neutral",
            "modes": {
              "light": "#7d8b96"
            }
          }
        }
      },
      "p1": {
        "$value": "#93c9b8",
        "$description": "Slightly positive (0.1 to 0.3).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-p1",
            "modes": {
              "light": "#6fa696"
            }
          }
        }
      },
      "p2": {
        "$value": "#4fd6ad",
        "$description": "Positive (0.3 to 0.6).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-p2",
            "modes": {
              "light": "#2a9f7c"
            }
          }
        }
      },
      "p3": {
        "$value": "#14e3a0",
        "$description": "Strongly positive (>= 0.6).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-p3",
            "modes": {
              "light": "#0b7f5c"
            }
          }
        }
      }
    },
    "topic": {
      "$description": "Same hue families as the current TOPIC_COLORS, so returning users keep their bearings, with one change: Technology moves from cyan to azure so cyan is free to mean \"selected\". Values are slightly desaturated for small, dense marks.",
      "all": {
        "$value": "#9ab0c1",
        "$description": "No topic filter.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-all",
            "modes": {
              "light": "#3d5466"
            }
          }
        }
      },
      "politics": {
        "$value": "#9b8cff",
        "$description": "Politics.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-politics",
            "modes": {
              "light": "#6550e0"
            }
          }
        }
      },
      "conflict": {
        "$value": "#ff6464",
