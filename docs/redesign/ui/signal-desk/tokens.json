  "typography": {
    "$description": "A compact scale built on 13px. Headlines never exceed 15px inside panels; hierarchy comes from weight and colour, which keeps the desk dense without shouting.",
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "15px",
        "fontWeight": 600,
        "lineHeight": "20px",
        "letterSpacing": "-0.005em"
      },
      "$description": "Preview headline, focused story title.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-title"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "13px",
        "fontWeight": 600,
