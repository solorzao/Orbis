    "accent": {
      "primary": {
        "$value": "#00d4ff",
        "$description": "Brand cyan. Interactive and selected state only.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--accent-primary",
            "modes": {
              "light": "#006d92"
            }
          }
        }
