      "strong": {
        "$value": "#5fe3ff",
        "$description": "Hover/pressed accent.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--accent-strong",
            "modes": {
              "light": "#005677"
            }
          }
        }
      },
      "soft": {
        "$value": "rgba(0, 212, 255, 0.12)",
        "$description": "Tinted fill behind active chips and brush ranges.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--accent-soft",
            "modes": {
              "light": "rgba(0, 109, 146, 0.10)"
            }
          }
        }
