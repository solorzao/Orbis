        "$extensions": {
          "co.orbisapp": {
            "css": "--text-primary",
            "modes": {
              "light": "#0f1c26"
            }
          }
        }
      },
      "secondary": {
        "$value": "#9ab0c1",
        "$description": "Body copy and secondary values.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--text-secondary",
            "modes": {
              "light": "#3d5466"
            }
          }
        }
      },
      "muted": {
        "$value": "#7690a3",
        "$description": "Column headers, captions, timestamps.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--text-muted",
            "modes": {
              "light": "#54687a"
            }
          }
        }
      },
      "inverse": {
        "$value": "#04121a",
