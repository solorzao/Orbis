          }
        }
      },
      "climate": {
        "$value": "#3fcf8e",
        "$description": "Climate.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-climate",
            "modes": {
              "light": "#178a5a"
            }
          }
        }
      },
      "economy": {
        "$value": "#f2b33d",
        "$description": "Economy.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-economy",
            "modes": {
              "light": "#a86d00"
            }
          }
        }
      },
      "health": {
        "$value": "#f075b6",
        "$description": "Health.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-health",
            "modes": {
              "light": "#c2427f"
            }
          }
