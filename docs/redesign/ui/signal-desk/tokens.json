    "globe": {
      "ocean": {
        "$value": "#0b1620",
        "$description": "Sphere material colour (no photo texture).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--globe-ocean",
            "modes": {
              "light": "#d9e3ea"
            }
          }
        }
      },
      "land": {
        "$value": "#2b4558",
        "$description": "Hex-dot land polygons.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--globe-land",
            "modes": {
              "light": "#8ea2b2"
            }
          }
        }
      },
      "atmosphere": {
        "$value": "#1b5f7a",
        "$description": "Thin atmosphere rim (altitude 0.1).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--globe-atmosphere",
            "modes": {
