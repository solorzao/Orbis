            "css": "--arc-coverage"
          }
        }
      },
      "highlight": {
        "$value": "#7fe9ff",
        "$description": "Inspected link or selected thread.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--arc-highlight"
          }
        }
      },
      "muted": {
        "$value": "rgba(127, 233, 255, 0.10)",
        "$description": "Filtered-out connections.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--arc-muted"
          }
        }
      },
      "relationCooperation": {
        "$value": "#6aa8ff",
        "$description": "Actor relation, cooperation (later phase).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--arc-relation-cooperation"
          }
        }
      },
      "relationConflict": {
        "$value": "#ff6b7d",
        "$description": "Actor relation, conflict (later phase).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--arc-relation-conflict"
          }
        }
      }
    },
    "hud": {
      "ringTrack": {
        "$value": "rgba(0, 212, 255, 0.20)",
        "$description": "Instrument ring track.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--hud-ring-track"
          }
        }
      },
      "ringTick": {
        "$value": "rgba(127, 233, 255, 0.42)",
