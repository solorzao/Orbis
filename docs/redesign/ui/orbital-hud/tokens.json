        "$extensions": {
          "co.orbisapp": {
            "css": "--hud-scanline"
          }
        }
      }
    }
  },
  "dataviz": {
    "$type": "color",
    "sentiment": {
      "$description": "Flare (warm red) to aurora (mint) through a cool grey. Built to stay readable as luminous marks on black: the positive end is much lighter than the negative end, so the scale survives red-green colour blindness, and every value prints its signed score.",
      "n3": {
        "$value": "#ff5c70",
        "$description": "Strongly negative (<= -0.6).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-n3"
          }
        }
      },
      "n2": {
        "$value": "#ff8f80",
        "$description": "Negative.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-n2"
          }
        }
      },
      "n1": {
        "$value": "#e6b5ae",
        "$description": "Slightly negative.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-n1"
          }
        }
      },
      "neutral": {
        "$value": "#8fb0bf",
        "$description": "Neutral.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-neutral"
          }
        }
      },
      "p1": {
        "$value": "#a9e8d3",
        "$description": "Slightly positive.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-p1"
          }
