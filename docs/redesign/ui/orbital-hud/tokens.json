{
  "$description": "Orbis design tokens: Orbital HUD. The globe is the cockpit window: a full-bleed holographic HUD with an instrument ring for topics and time, lock-on previews and pulsing connection arcs.",
  "$extensions": {
    "co.orbisapp": {
      "direction": "orbital-hud",
      "version": "0.1.0",
      "modes": [
        "dark"
      ],
      "modeConvention": "$value holds the dark (default) value. Light values, where the direction supports a light theme, are in $extensions['co.orbisapp'].modes.light. CSS variable names are in $extensions['co.orbisapp'].css."
    }
  },
  "brand": {
    "$description": "Frozen brand lockup. Identical in every direction; copied from frontend/src/app/page.tsx. Do not restyle.",
    "logo": {
      "asset": {
        "$type": "string",
        "$value": "/Orbis_logo_50_resize.png",
        "$description": "Source PNG with transparent background (553x556). Render with <img>, never redraw."
      },
      "size": {
        "$type": "dimension",
        "$value": "40px",
        "$description": "Desktop (Tailwind sm:h-10). Mobile is 28px (h-7)."
      },
      "sizeMobile": {
        "$type": "dimension",
        "$value": "28px"
      },
      "filter": {
        "$type": "string",
        "$value": "drop-shadow(0 0 12px rgba(0, 212, 255, 0.5))"
      },
      "gap": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Gap between logo and text block (sm:gap-3). 8px on mobile."
      }
    },
    "wordmark": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Orbitron",
        "fontWeight": 700,
        "fontSize": "18px",
        "lineHeight": "28px",
        "letterSpacing": "0.2em"
      },
      "$description": "Text 'Orbis' rendered uppercase (text-transform), Tailwind text-lg font-bold tracking-[0.2em]. 14px/20px on mobile.",
      "$extensions": {
        "co.orbisapp": {
          "textTransform": "uppercase",
          "textShadow": "0 0 30px rgba(0, 212, 255, 0.4)",
          "color": "{color.text.primary}"
        }
      }
    },
    "motto": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, sans-serif",
        "fontWeight": 500,
        "fontSize": "9px",
        "lineHeight": "13.5px",
        "letterSpacing": "0.3em"
      },
      "$description": "Text 'Every Story, Everywhere', uppercase, inherits the body system font. Hidden below 640px (hidden sm:block).",
      "$extensions": {
        "co.orbisapp": {
          "textTransform": "uppercase",
          "color": "{color.text.muted}",
          "note": "Colour stays the app's existing --text-muted (#3a7090 dark / #94a3b8 light) so the lockup is unchanged."
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "brand": {
        "$value": [
          "Orbitron",
          "sans-serif"
        ],
        "$description": "Wordmark only. Never used for HUD readouts, so the brand stays distinct.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--font-brand"
          }
        }
      },
      "heading": {
        "$value": [
          "Space Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Panel titles, headlines, ring labels.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--font-heading"
          }
        }
      },
      "body": {
        "$value": [
          "Space Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Prose.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--font-body"
          }
        }
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Readouts, coordinates, scores, timestamps.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--font-mono"
          }
        }
      }
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "page": {
        "$value": "#01050a",
        "$description": "Deep space behind the globe.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--bg-page"
