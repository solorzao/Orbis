          "co.orbisapp": {
            "css": "--border-default"
          }
        }
      },
      "strong": {
        "$value": "rgba(127, 233, 255, 0.62)",
        "$description": "Corner brackets, active strokes.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--border-strong"
          }
        }
      },
      "focus": {
        "$value": "#7fe9ff",
        "$description": "Keyboard focus ring.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--border-focus"
          }
        }
      }
    },
    "text": {
      "primary": {
        "$value": "#e2f8ff",
        "$description": "Headlines and values.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--text-primary"
          }
        }
      },
      "secondary": {
        "$value": "#9fd2e4",
        "$description": "Body copy.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--text-secondary"
          }
        }
      },
      "muted": {
        "$value": "#74acc2",
        "$description": "Captions, units, ring labels.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--text-muted"
