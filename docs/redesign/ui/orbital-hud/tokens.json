      },
      "p2": {
        "$value": "#5ff0c0",
        "$description": "Positive.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-p2"
          }
        }
      },
      "p3": {
        "$value": "#19f5a8",
        "$description": "Strongly positive (>= 0.6).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--sentiment-p3"
          }
        }
      }
    },
    "topic": {
      "$description": "Luminous versions of the current topic hues, tuned to glow on black. Technology moves from cyan to azure so cyan stays the HUD's own voice.",
      "all": {
        "$value": "#9fd2e4",
        "$description": "No topic filter.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-all"
          }
        }
      },
      "politics": {
        "$value": "#b49aff",
        "$description": "Politics.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-politics"
          }
        }
      },
      "conflict": {
        "$value": "#ff5c70",
        "$description": "Conflict.",
        "$extensions": {
