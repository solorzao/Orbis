            "css": "--signal-danger"
          }
        }
      }
    },
    "globe": {
      "tint": {
        "$value": "#0a1a2e",
        "$description": "Material colour until the texture loads (three-globe then clears it, as in the current app); the glow comes from emissive.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--globe-tint"
          }
        }
      },
      "emissive": {
        "$value": "#063040",
        "$description": "Material self-glow (emissiveIntensity 0.6).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--globe-emissive"
          }
        }
      },
      "atmosphere": {
        "$value": "#00d4ff",
        "$description": "Atmosphere (altitude 0.22).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--globe-atmosphere"
          }
        }
      }
    },
    "arc": {
      "coverage": {
        "$value": "rgba(159, 210, 228, 0.40)",
