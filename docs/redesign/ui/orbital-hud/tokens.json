        "fontFamily": "{font.family.body}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": "21px",
        "letterSpacing": "0"
      },
      "$description": "Co-pilot answers, summaries.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-body"
        }
      }
    },
    "bodySm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": "19px",
        "letterSpacing": "0"
      },
      "$description": "List items, secondary prose.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-body-sm"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": "16px",
        "letterSpacing": "0.02em"
      },
      "$description": "Ring labels, control labels.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-label"
        }
      }
    },
    "readoutXl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "26px",
        "fontWeight": 300,
        "lineHeight": "30px",
        "letterSpacing": "0"
      },
      "$description": "UTC clock.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-readout-xl",
          "fontFeatureSettings": "\"tnum\" 1, \"zero\" 1"
