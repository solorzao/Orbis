            "css": "--topic-conflict"
          }
        }
      },
      "technology": {
        "$value": "#5cb8ff",
        "$description": "Technology (was #06B6D4).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-technology"
          }
        }
      },
      "climate": {
        "$value": "#4ff0a8",
        "$description": "Climate.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-climate"
          }
        }
      },
      "economy": {
        "$value": "#ffc04d",
        "$description": "Economy.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-economy"
          }
        }
      },
      "health": {
        "$value": "#ff7ad9",
        "$description": "Health.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--topic-health"
          }
        }
      }
    }
  },
  "typography": {
    "$description": "Airier than the desk: 14px body, generous line height, and a light-weight mono for large readouts so numbers feel projected rather than printed.",
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "18px",
        "fontWeight": 600,
        "lineHeight": "24px",
        "letterSpacing": "-0.01em"
      },
      "$description": "Lock-on preview headline.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-title"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "14px",
        "fontWeight": 600,
        "lineHeight": "18px",
        "letterSpacing": "0.01em"
      },
      "$description": "Panel titles.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--type-heading"
        }
