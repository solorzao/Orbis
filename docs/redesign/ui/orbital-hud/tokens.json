    "$type": "dimension",
    "$description": "4px base. Glass panels breathe more than the desk: 16px padding, 12px between items."
  },
  "radius": {
    "$type": "dimension",
    "$description": "Glass panels are square-cornered and marked by corner brackets (`radius.bracket` is the bracket arm length, drawn with background gradients so no clip-path is needed). Chips and buttons are pills, so glass and controls are never confused.",
    "none": {
      "$value": "0px",
      "$description": "Glass panels.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--radius-none"
        }
      }
    },
    "bracket": {
      "$value": "10px",
      "$description": "Corner bracket arm length on panels, readouts and the reticle.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--radius-bracket"
        }
      }
    },
    "pill": {
      "$value": "999px",
      "$description": "Chips, buttons, status dots.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--radius-pill"
        }
      }
    }
  },
  "borderWidth": {
    "$type": "dimension",
    "hairline": {
      "$value": "1px",
      "$description": "Glass strokes, ticks.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--bw-hairline"
        }
      }
    },
    "strong": {
      "$value": "2px",
      "$description": "Corner brackets, active ring segment.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--bw-strong"
        }
      }
    }
  },
  "blur": {
    "$type": "dimension",
    "$description": "Backdrop blur radii. Each is a performance cost over the WebGL canvas; see the low-power rule.",
    "panel": {
      "$value": "14px",
      "$description": "Glass panels. Dropped to 0 in low-power mode.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--blur-panel"
        }
      }
    },
    "overlay": {
      "$value": "18px",
      "$description": "Preview card.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--blur-overlay"
        }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "No drop shadows: depth comes from light. Glows are cyan, short and reserved for state.",
    "glowSm": {
      "$value": [
        {
          "color": "rgba(0, 212, 255, 0.35)",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "8px",
          "spread": "0px"
        }
      ],
      "$description": "Live dot, active chip.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--elev-glow-sm"
        }
      }
    },
    "glowMd": {
      "$value": [
        {
          "color": "rgba(0, 212, 255, 0.28)",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "22px",
          "spread": "0px"
        }
      ],
      "$description": "Locked-on preview card edge.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--elev-glow-md"
        }
      }
    },
    "innerEdge": {
      "$value": [
        {
          "color": "rgba(127, 233, 255, 0.10)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ],
      "$description": "Top-edge highlight on glass.",
      "$extensions": {
        "co.orbisapp": {
          "css": "--elev-inner-edge"
        }
      }
    }
  },
  "motion": {
    "$description": "Cinematic but bounded. One boot sequence (ring draw + lock-on), then motion only marks change. Under `prefers-reduced-motion: reduce`: no boot sequence, no arc dashes, no auto-rotate, fly-to becomes a cut. A low-power mode (auto-enabled when `navigator.hardwareConcurrency <= 4` or frame time > 24ms) also drops blur and dashes.",
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "140ms",
        "$description": "Hover, chip toggle.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--dur-fast"
          }
        }
      },
      "base": {
        "$value": "220ms",
        "$description": "Panel content change.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--dur-base"
          }
        }
      },
      "lockOn": {
        "$value": "420ms",
        "$description": "Reticle brackets converge on a location.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--dur-lock-on"
          }
        }
      },
      "ringDraw": {
        "$value": "1100ms",
        "$description": "Ring draws in on first load (once).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--dur-ring-draw"
          }
        }
      },
      "flyTo": {
        "$value": "1400ms",
        "$description": "Camera move.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--dur-fly-to"
          }
        }
      },
      "arcDash": {
        "$value": "4000ms",
        "$description": "One dash cycle along a selected thread arc.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--dur-arc-dash"
          }
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "UI.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ease-standard"
          }
        }
      },
      "emphasized": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "Lock-on, ring draw (fast out, long settle).",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ease-emphasized"
          }
        }
      },
      "camera": {
        "$value": [
          0.65,
          0,
          0.35,
          1
        ],
        "$description": "Fly-to.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ease-camera"
          }
        }
      },
      "linear": {
        "$value": [
          0,
          0,
          1,
          1
        ],
        "$description": "Arc dash travel.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ease-linear"
          }
        }
      }
    }
  },
  "zIndex": {
    "$type": "number",
    "$description": "Stacking order of the cockpit layers.",
    "globe": {
      "$value": 0,
      "$extensions": {
        "co.orbisapp": {
          "css": "--z-globe"
        }
      }
    },
    "ring": {
      "$value": 5,
      "$extensions": {
        "co.orbisapp": {
          "css": "--z-ring"
        }
      }
    },
    "reticle": {
      "$value": 8,
      "$extensions": {
        "co.orbisapp": {
          "css": "--z-reticle"
        }
      }
    },
    "panel": {
      "$value": 20,
      "$extensions": {
        "co.orbisapp": {
          "css": "--z-panel"
        }
      }
    },
    "preview": {
      "$value": 30,
      "$extensions": {
        "co.orbisapp": {
          "css": "--z-preview"
        }
      }
    },
    "menu": {
      "$value": 40,
      "$extensions": {
        "co.orbisapp": {
          "css": "--z-menu"
        }
      }
    },
    "toast": {
      "$value": 50,
      "$extensions": {
        "co.orbisapp": {
          "css": "--z-toast"
        }
      }
    }
  },
  "component": {
    "$description": "Component patterns. Values alias the role tokens above.",
    "panel": {
      "$description": "Translucent square panel with a faint 1px stroke, four corner brackets in `border.strong` and a 1px inner top highlight. Title row is 36px. Never placed over the instrument ring.",
      "background": {
        "$type": "color",
        "$value": "{color.surface.panel}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--panel-background"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.border.subtle}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--panel-border"
          }
        }
      },
      "bracket": {
        "$type": "dimension",
        "$value": "{radius.bracket}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--panel-bracket"
          }
        }
      },
      "bracketColor": {
        "$type": "color",
        "$value": "{color.border.strong}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--panel-bracket-color"
          }
        }
      },
      "blur": {
        "$type": "dimension",
        "$value": "{blur.panel}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--panel-blur"
          }
        }
      },
      "edge": {
        "$type": "shadow",
        "$value": "{elevation.innerEdge}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--panel-edge"
          }
        }
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.5}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--panel-padding"
          }
        }
      },
      "title": {
        "$type": "typography",
        "$value": "{typography.heading}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--panel-title"
          }
        }
      }
    },
    "ring": {
      "$description": "SVG ring concentric with the globe (radius = globe radius x 1.14). Ticks every 5 degrees. Top arc (200 to 340 degrees): seven topic segments, labels on a text path. Bottom arc (20 to 160 degrees): 7 x 24 hourly bars radiating outward, length proportional to volume; the selected range is drawn in `hud.ringActive` with two handles. Recomputed on zoom and resize.",
      "track": {
        "$type": "color",
        "$value": "{color.hud.ringTrack}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ring-track"
          }
        }
      },
      "tick": {
        "$type": "color",
        "$value": "{color.hud.ringTick}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ring-tick"
          }
        }
      },
      "active": {
        "$type": "color",
        "$value": "{color.hud.ringActive}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ring-active"
          }
        }
      },
      "label": {
        "$type": "typography",
        "$value": "{typography.label}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ring-label"
          }
        }
      },
      "radiusFactor": {
        "$type": "string",
        "$value": "1.14",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ring-radius-factor"
          }
        }
      },
      "barMaxLength": {
        "$type": "dimension",
        "$value": "34px",
        "$extensions": {
          "co.orbisapp": {
            "css": "--ring-bar-max-length"
          }
        }
      }
    },
    "chip": {
      "$description": "Pill, 26px. Used inside panels (suggested prompts, entity tags). Active chips get `accent.soft` fill and `elevation.glowSm`.",
      "height": {
        "$type": "dimension",
        "$value": "26px",
        "$extensions": {
          "co.orbisapp": {
            "css": "--chip-height"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.pill}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--chip-radius"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.border.default}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--chip-border"
          }
        }
      },
      "activeFill": {
        "$type": "color",
        "$value": "{color.accent.soft}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--chip-active-fill"
          }
        }
      },
      "activeGlow": {
        "$type": "shadow",
        "$value": "{elevation.glowSm}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--chip-active-glow"
          }
        }
      },
      "label": {
        "$type": "typography",
        "$value": "{typography.label}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--chip-label"
          }
        }
      }
    },
    "readout": {
      "$description": "Unit label above a light-weight mono value, bracketed by two 6px corner ticks. Used for UTC time, volume and coordinates.",
      "value": {
        "$type": "typography",
        "$value": "{typography.readoutXl}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--readout-value"
          }
        }
      },
      "valueColor": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--readout-value-color"
          }
        }
      },
      "label": {
        "$type": "typography",
        "$value": "{typography.dataSm}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--readout-label"
          }
        }
      },
      "labelColor": {
        "$type": "color",
        "$value": "{color.text.muted}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--readout-label-color"
          }
        }
      },
      "bracket": {
        "$type": "color",
        "$value": "{color.border.strong}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--readout-bracket"
          }
        }
      }
    },
    "preview": {
      "$description": "Four corner brackets converge on the location (`motion.duration.lockOn`) and a leader line runs from the reticle to a 340px card docked at the top of the right column (the card does not follow the dot, so it never covers the globe). Card: image in cyan duotone with static scanlines (an orbital crop of the night texture when `image_url` is missing), headline, source and time, topic mix, a semicircular tone gauge with signed score, a 24 h sparkline, entity chips and the AI brief.",
      "width": {
        "$type": "dimension",
        "$value": "340px",
        "$extensions": {
          "co.orbisapp": {
            "css": "--preview-width"
          }
        }
      },
      "background": {
        "$type": "color",
        "$value": "{color.surface.overlay}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--preview-background"
          }
        }
      },
      "blur": {
        "$type": "dimension",
        "$value": "{blur.overlay}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--preview-blur"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.border.strong}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--preview-border"
          }
        }
      },
      "glow": {
        "$type": "shadow",
        "$value": "{elevation.glowMd}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--preview-glow"
          }
        }
      },
      "reticle": {
        "$type": "color",
        "$value": "{color.hud.reticle}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--preview-reticle"
          }
        }
      },
      "enter": {
        "$type": "duration",
        "$value": "{motion.duration.lockOn}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--preview-enter"
          }
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.emphasized}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--preview-easing"
          }
        }
      }
    },
    "connection": {
      "$description": "Great-circle arc with an animated dash (length 0.4, gap 0.2) travelling from the earlier story to the later one. Selected thread uses `arc.highlight` with stroke 0.6; others `arc.default`, static, stroke 0.3.",
      "stroke": {
        "$type": "string",
        "$value": "0.3",
        "$extensions": {
          "co.orbisapp": {
            "css": "--connection-stroke"
          }
        }
      },
      "strokeActive": {
        "$type": "string",
        "$value": "0.6",
        "$extensions": {
          "co.orbisapp": {
            "css": "--connection-stroke-active"
          }
        }
      },
      "color": {
        "$type": "color",
        "$value": "{color.arc.coverage}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--connection-color"
          }
        }
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.arc.highlight}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--connection-highlight"
          }
        }
      },
      "dashLength": {
        "$type": "string",
        "$value": "0.4",
        "$extensions": {
          "co.orbisapp": {
            "css": "--connection-dash-length"
          }
        }
      },
      "dashGap": {
        "$type": "string",
        "$value": "0.2",
        "$extensions": {
          "co.orbisapp": {
            "css": "--connection-dash-gap"
          }
        }
      },
      "dashTime": {
        "$type": "duration",
        "$value": "{motion.duration.arcDash}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--connection-dash-time"
          }
        }
      }
    },
    "console": {
      "$description": "Glass panel bottom-left. Assistant text streams with a block cursor; tool activity shows as a single status line with a progress tick; citations are chips that fly the globe and lock on.",
      "background": {
        "$type": "color",
        "$value": "{color.surface.panel}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--console-background"
          }
        }
      },
      "prose": {
        "$type": "typography",
        "$value": "{typography.body}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--console-prose"
          }
        }
      },
      "status": {
        "$type": "typography",
        "$value": "{typography.dataSm}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--console-status"
          }
        }
      },
      "statusColor": {
        "$type": "color",
        "$value": "{color.accent.strong}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--console-status-color"
          }
        }
      },
      "citationFill": {
        "$type": "color",
        "$value": "{color.accent.soft}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--console-citation-fill"
          }
        }
      },
      "inputBackground": {
        "$type": "color",
        "$value": "{color.bg.inset}",
        "$extensions": {
          "co.orbisapp": {
            "css": "--console-input-background"
          }
        }
      }
    }
  }
}
