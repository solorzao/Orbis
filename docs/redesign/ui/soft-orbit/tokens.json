{
  "$description": "Orbis design tokens: Soft Orbit. Signal Desk's features in a calm, frosted cockpit: rounded glass panels float over a drifting globe wrapped in orbital rings, with cyan easing into periwinkle and lavender.",
  "$extensions": {
    "co.orbisapp": {
      "direction": "soft-orbit",
      "version": "0.1.0",
      "modes": [
        "dark"
      ],
      "modeConvention": "$value holds the dark (default) value. Light values, where the direction supports a light theme, are in $extensions['co.orbisapp'].modes.light. CSS variable names are in $extensions['co.orbisapp'].css."
    }
  },
  "brand": {
    "$description": "Frozen brand lockup. Identical in every direction; copied from frontend/src/app/page.tsx. Do not restyle.",
    "logo": {
      "asset": {
        "$type": "string",
        "$value": "/Orbis_logo_50_resize.png",
        "$description": "Source PNG with transparent background (553x556). Render with <img>, never redraw."
      },
      "size": {
        "$type": "dimension",
        "$value": "40px",
        "$description": "Desktop (Tailwind sm:h-10). Mobile is 28px (h-7)."
      },
      "sizeMobile": {
        "$type": "dimension",
        "$value": "28px"
      },
      "filter": {
        "$type": "string",
        "$value": "drop-shadow(0 0 12px rgba(0, 212, 255, 0.5))"
      },
      "gap": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Gap between logo and text block (sm:gap-3). 8px on mobile."
      }
    },
    "wordmark": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Orbitron",
        "fontWeight": 700,
        "fontSize": "18px",
        "lineHeight": "28px",
        "letterSpacing": "0.2em"
      },
      "$description": "Text 'Orbis' rendered uppercase (text-transform), Tailwind text-lg font-bold tracking-[0.2em]. 14px/20px on mobile.",
      "$extensions": {
        "co.orbisapp": {
          "textTransform": "uppercase",
          "textShadow": "0 0 30px rgba(0, 212, 255, 0.4)",
          "color": "{color.text.primary}"
        }
      }
    },
    "motto": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, sans-serif",
        "fontWeight": 500,
        "fontSize": "9px",
        "lineHeight": "13.5px",
        "letterSpacing": "0.3em"
      },
      "$description": "Text 'Every Story, Everywhere', uppercase, inherits the body system font. Hidden below 640px (hidden sm:block).",
      "$extensions": {
        "co.orbisapp": {
          "textTransform": "uppercase",
          "color": "#4482a8",
          "colorLight": "#5c6f8a",
          "note": "Dedicated motto colour, same hue as the original #3a7090, nudged to meet WCAG AA at 9px: 4.6:1 on Soft Orbit's #0d0c17 (dark) and 4.6:1 on #f0f4f8 (light, the live app's --text-motto). Wording, font, size and tracking are unchanged."
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "brand": {
        "$value": [
          "Orbitron",
          "sans-serif"
        ],
        "$description": "Wordmark only.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--font-brand"
          }
        }
      },
      "heading": {
        "$value": [
          "Space Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Titles, labels and controls, at 400 to 500.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--font-heading"
          }
        }
      },
      "body": {
        "$value": [
          "Space Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Prose at 400.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--font-body"
          }
        }
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Numbers only: counts, scores, times, coordinates.",
        "$extensions": {
          "co.orbisapp": {
            "css": "--font-mono"
          }
        }
      }
    }
  },
